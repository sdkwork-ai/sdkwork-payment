# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_payment_demo` (table
# prefix `commerce_`) and a dedicated Redis logical DB index so no cache key collides with another
# shared-redis environment.
SDKWORK_PAYMENT_DEPLOYMENT_PROFILE=cloud
SDKWORK_PAYMENT_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_PAYMENT_PROFILE_ID=cloud.demo
SDKWORK_PAYMENT_APPLICATION_PUBLIC_HTTP_URL=https://payment-demo.sdkwork.com
SDKWORK_PAYMENT_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
