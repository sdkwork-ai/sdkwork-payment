# SDKWork unified workspace PostgreSQL profile.
# Canonical source: sdkwork-specs/ENVIRONMENT_SPEC.md section 7.1.
# Copy to .env.postgres in the selected application root for host-local overrides.
# Do not commit .env.postgres.
#
# All SDKWork applications MUST use these SDKWORK_DATABASE_* keys for PostgreSQL
# connection identity. Per-app SDKWORK_<APP>_DATABASE_* keys are migration-only
# inputs and MUST NOT be read by application startup or checked-in profiles.

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA_FALLBACK_PUBLIC=false
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

# Optional: direct connection URL. If set, it takes precedence over split fields above.
# SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev?sslmode=disable

# Required for database init when creating roles/databases with an admin connection.
SDKWORK_DATABASE_ADMIN_HOST=127.0.0.1
SDKWORK_DATABASE_ADMIN_PORT=5432
SDKWORK_DATABASE_ADMIN_USERNAME=postgres
SDKWORK_DATABASE_ADMIN_PASSWORD=postgres_admin_pass
SDKWORK_DATABASE_ADMIN_DATABASE=postgres
SDKWORK_DATABASE_ADMIN_SSL_MODE=disable

# Optional: direct admin connection URL.
# SDKWORK_DATABASE_ADMIN_URL=postgresql://postgres:postgres_admin_pass@127.0.0.1:5432/postgres?sslmode=disable

# --- Payment runtime (see docs/architecture/tech/TECH_ARCHITECTURE.md) ---
# Ingress bind for the standalone payment API process. The topology key is
# canonical; PAYMENT_API_BIND is accepted as a legacy alias.
# SDKWORK_PAYMENT_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18094
# Notify base URL used to build PSP webhook endpoints when no notify domain is
# configured: {base}/app/v3/api/orders/payments/webhooks/{providerCode}
# ORDER_PAYMENT_WEBHOOK_BASE_URL=https://api.example.com
# Browser CORS allow-list (comma-separated; never use *)
# SDKWORK_CORS_ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com
# Credential master key file (REQUIRED outside development; absolute path)
# SDKWORK_PAYMENT_CREDENTIAL_MASTER_KEY_FILE=/etc/sdkwork/commerce/payment-credential-master.secret
# Compensation worker (default on at 60s cadence)
# SDKWORK_PAYMENT_COMPENSATION_ENABLED=1
# SDKWORK_PAYMENT_COMPENSATION_INTERVAL_SECONDS=60
# SDKWORK_PAYMENT_COMPENSATION_MIN_AGE_SECONDS=90


